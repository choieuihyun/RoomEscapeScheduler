rules_version = '2';

/* ⚠ 이 파일은 main 푸시·CI 로 올라가지 않는다(CI 는 호스팅만 배포). 바꾸면 따로 게시하고, 게시된 규칙을 읽어 확인한다:
 *   npx -y firebase-tools@latest deploy --only firestore:rules --project roomescapescheduler   (사용자 확인 뒤 — 운영 보안 규칙)
 *   또는 Firebase 콘솔 → Firestore Database → 규칙 에 붙여넣고 게시.
 * 2026-10-27 실제로 겪음: 10-19 에 구글·카카오 허용으로 고친 규칙이 게시되지 않아(콘솔은 08-21 판) 소셜 계정의
 *   일정 저장이 "Missing or insufficient permissions" 로 막혀 있었다. 사용자가 콘솔에서 게시해 해결(배포.md §4).
 *
 * 규칙이 곧 보안이다. firebase-config.js 의 값은 공개되어도 되지만,
 * 이 규칙이 느슨하면 아무나 남의 문서를 읽고 쓸 수 있다.
 * 기본값인 "테스트 모드" 는 30일 뒤 모두 잠기므로 반드시 바꿔야 한다.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* 자기 문서만. 로그인하지 않았거나 uid 가 다르면 읽기조차 막힌다.
     *
     * 마지막 줄은 "우리 화면을 거친 계정인가" 를 본다.
     * apiKey 는 페이지 소스에 그대로 있으므로 누구나 REST 로 직접
     * accounts:signUp 을 불러 아무 이메일로나 계정을 만들 수 있다 —
     * 화면의 아이디 형식 검사는 화면에서만 돌기 때문이다.
     * 그렇게 만든 계정은 남의 문서를 못 보지만(위 두 줄), 자기 uid 밑에
     * 쓰기를 퍼부어 하루 한도를 태울 수는 있다. 그래서 이메일 계정은 우리
     * 도메인(@user.resched)만 통과시켜 그 길을 좁힌다.
     *
     * 구글(google.com)과 카카오(custom)도 통과시킨다(기획 §4.54).
     * 구글은 apiKey 만으로는 계정을 못 만든다(구글 계정이 필요하다).
     * 'custom' = 우리 서버가 서비스 계정 키로 서명한 토큰, 현재 카카오 로그인 전용.
     * 서버가 다른 용도로 커스텀 토큰을 발급하면 같은 권한을 얻는다.
     * 그래서 도메인 조건과 따로 연다.
     * 커스텀 토큰에는 이메일 클레임이 없다. 맵에 없는 키를 읽으면 null 이 아니라
     * 평가 오류가 나므로, get() 의 기본값으로 이메일 없음을 false 로 떨어뜨린다.
     *
     * 주의: 로그인 수단을 더 붙이면 아래 provider 목록도 함께 고친다.
     */
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && (
                              request.auth.token.get('email', '').matches('.*@user[.]resched')
                              || request.auth.token.firebase.sign_in_provider in ['google.com', 'custom']
                            );
    }

    /* 그 밖의 모든 경로는 차단 */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
